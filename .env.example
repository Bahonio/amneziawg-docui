# Numeric GID printed by install-host-agent.sh
AWG_DOCUI_AGENT_GID=992
AWG_DOCUI_IMAGE=ghcr.io/bahonio/awg-docui:latest

WEB_UI_USER=admin
# Required: base64-encoded SHA-256 digest. Generate one with:
# printf '%s' 'choose-a-long-password' | openssl dgst -sha256 -binary | base64
WEB_UI_PASSWORD=
WEB_UI_PORT=54845
# Keep loopback when using an SSH tunnel or reverse proxy. To expose the panel
# directly on the VPN interface, set the host address, for example 10.66.66.1.
WEB_UI_BIND_ADDRESS=127.0.0.1
# Optional browser URL printed by the installer. Does not configure DNS / TLS.
WEB_UI_URL=

DEFAULT_MTU=1280
DEFAULT_SUBNET=10.0.0.0/24
DEFAULT_PORT=54844
DEFAULT_DNS=8.8.8.8,1.1.1.1
